.env
venv/
.venv/
__pycache__/
*.pyc
*.onnx
*.wav
!sounds/.gitkeep
# Generated alongside the activation WAVs by generate_activation_phrases.py.
# Committing it would let the line text drift from the audio it describes.
sounds/california_activations/**/manifest.json
models/
.DS_Store
watch_state.json
config.local.yaml
vpn_state.json
debug/
hardware/esp32_bt_wake/secrets.yaml

# Recorded wake-word takes: audio output, and personal voice data
training/recordings/
debug/wakeword/

# Samsung TV pairing token, generated on first CEC wake
samsung_token.txt
tv_state.json
device_state.json

# Ecovacs device id and cached login token, generated on first deebot
# probe/login and must stay stable across runs -- see tools/deebot_session.py.
# The credentials file holds a live session token, never commit it.
.deebot_device_id
.deebot_credentials.json

# WhatsApp contact book (whatsapp.contacts_path). A VCF export of the phone's
# address book -- a few hundred real people's phone numbers, so local-only for
# the same reason .deebot_credentials.json is. Drop your own export here.
contacts.vcf

# The WhatsApp Web browser profile (whatsapp.profile_dir). It holds a linked-device
# session for Master Miguel's account -- the session IS the credential, so it is
# local-only for the same reason as the two files above.
.whatsapp_profile/

# WhatsApp nicknames (whatsapp.aliases_path). Says who his family, partner and
# friends are, and the repository is public -- local-only like contacts.vcf.
whatsapp_aliases.yaml
