# ============================================================
# PROJECT CALIFORNIA — Environment Variables
# ============================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
# ============================================================

# Groq API Key (free tier — https://console.groq.com/keys)
# Used for: Speech-to-Text (Whisper)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Anthropic API Key (https://console.anthropic.com/settings/keys)
# Used for: LLM brain (Claude Sonnet)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Fireworks.ai API Key (https://fireworks.ai/api-keys)
# Used for: LLM brain (only if llm.provider = "fireworks" in config.yaml)
FIREWORKS_API_KEY=fw_your_fireworks_api_key_here

# Optional: OpenAI API Key (https://platform.openai.com/api-keys)
# Used for: LLM brain (only if llm.provider = "openai" in config.yaml)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Optional: ElevenLabs API Key (https://elevenlabs.io/api)
# Used for: Premium TTS (only if tts.provider = "elevenlabs" in config.yaml)
ELEVENLABS_API_KEY=

# Optional: Google Cloud Text-to-Speech API Key
# Used for: Chirp 3 HD TTS (only if tts.provider = "google" in config.yaml)
# Setup: https://console.cloud.google.com -> create project -> enable
# "Cloud Text-to-Speech API" -> APIs & Services > Credentials > Create API key.
# Billing must be enabled on the project even though Chirp 3 HD includes
# 1M characters/month free (roughly 15-20 hours of speech).
GOOGLE_TTS_API_KEY=

# Picovoice Access Key (https://console.picovoice.ai/)
# Used for: Porcupine wake word detection (only if wake_word.model ends in .ppn)
PICOVOICE_ACCESS_KEY=

# Stremio credentials (used for library sync and continue watching)
STREMIO_EMAIL=
STREMIO_PASSWORD=

# TMDB credentials (set at least one)
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Govee API Key — apply in the Govee Home app under profile > settings > Apply for API Key
# ONLY needed if config.yaml sets govee.transport = "cloud". The default "ble"
# transport talks straight to the light over Bluetooth and needs no credentials.
# Note the cloud API only sees Wi-Fi models on Govee's published whitelist.
GOVEE_API_KEY=

# EcoVacs account (Deebot vacuum), same login as the EcoVacs Home app.
# Used for: control_vacuum (services/deebot_service.py). Without these the
# vacuum tool disables itself and the rest of the assistant keeps working.
ECOVACS_EMAIL=
ECOVACS_PASSWORD=
ECOVACS_COUNTRY=PT

# Gmail App Password for ECOVACS_EMAIL's inbox (NOT the account password).
# Generate at https://myaccount.google.com/apppasswords (needs 2-Step
# Verification enabled first). Lets services/deebot_session.py auto-read
# Ecovacs' device-verification emails over IMAP instead of asking a human
# for the code every ~7 days -- see services/gmail_verification_code.py.
# Strongly recommended: without it, a verification demand stops the vacuum
# tool until you set ECOVACS_VERIFICATION_CODE=<code from the email> once.
GMAIL_APP_PASSWORD=
# ECOVACS_VERIFICATION_CODE=

# WhatsApp (control_whatsapp) needs NO environment variable, and that is
# deliberate rather than an omission. services/whatsapp_service.py drives
# WhatsApp Web in Firefox, so the credential is the Firefox profile's own
# signed-in session: log into web.whatsapp.com once, tick "stay signed in",
# and that is the whole setup. The contact book is a local VCF at
# whatsapp.contacts_path in config.yaml (gitignored). Windows only; the
# service disables itself everywhere else and the rest of the assistant
# keeps working.
# FIREFOX_PATH=   # optional, overrides whatsapp.firefox_path
